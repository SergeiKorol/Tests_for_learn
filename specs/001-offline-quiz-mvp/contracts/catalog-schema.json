{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offline-quiz.app/contracts/catalog-schema.json",
  "title": "TestCatalog",
  "description": "index.json в корне репозитория-источника",
  "type": "array",
  "items": { "$ref": "#/$defs/catalogEntry" },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "required": ["id", "title", "version", "questionsCount"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "questionsCount": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "description": "Относительный путь от catalogBaseUrl; default: tests/{id}.json"
        }
      }
    }
  }
}
